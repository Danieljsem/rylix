# Copy to .env and fill in what you want to use. Both are optional.

# Genius API token (https://genius.com/api-clients). Enables Genius as a second
# lyrics source (section labels, cross-checking). Read the README note first.
GENIUS_TOKEN=

# AudD API token (https://audd.io). Enables "recognize what is playing" from PC audio.
AUDD_TOKEN=
